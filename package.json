{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "vite build && esbuild api/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && esbuild api/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=\"api/[...all].js\"",
    "test": "npm run test:payments && npm run test:staff",
    "test:payments": "tsx --test server/payment-utils.test.ts",
    "test:staff": "npm --prefix staff-dashboard test",
    "staff:dev": "npm --prefix staff-dashboard run dev",
    "staff:api": "npm --prefix staff-dashboard run dev:api",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "oxfmt": "^0.2.0",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
