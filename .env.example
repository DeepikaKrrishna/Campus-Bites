# ==============================================================================
# CAMPUS BITES ENVIRONMENT CONFIGURATION (PLACEHOLDERS ONLY)
# ==============================================================================

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (server-side ONLY, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Test Mode credentials (from Razorpay Dashboard -> Settings -> API Keys)
# The server returns the public Key ID to checkout; keep credentials server-side.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Canteen Staff Security Passkey (used to verify authorized staff access)
STAFF_SECRET_PASSKEY=your_staff_passkey

# Backend Server Configuration
SERVER_PORT=5001
NODE_ENV=development
