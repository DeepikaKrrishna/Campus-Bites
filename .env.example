# ==============================================================================
# CAMPUS BITES ENVIRONMENT CONFIGURATION (PLACEHOLDERS ONLY)
# ==============================================================================

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_jwt_token_here

# Supabase Service Role Key (Server-side ONLY, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_jwt_token_here

# Razorpay Test Mode credentials (from Razorpay Dashboard -> Account & Settings -> API Keys)
# The backend returns the public Key ID with each server-created Razorpay order.
# Never prefix the Key Secret or Webhook Secret with VITE_.
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Canteen Staff Security Passkey (used to verify authorized staff access)
STAFF_SECRET_PASSKEY=CAMPUS_CHEF_2026

# Backend Server Configuration
SERVER_PORT=5001
NODE_ENV=development
